% Overrides de tokens !!{…} para o livro Teoria dos Conjuntos (PT).
% Carregado automaticamente via \oljobname-config.sty quando \oljobname=settheory.

% Tokens de texto PT-BR (sobrepõe definições de open-logic-config.sty)
\settexttoken{enumerable}{enumerável}{enumeráveis}
\settexttoken{nonenumerable}{não enumerável}{não enumeráveis}
\settexttoken{denumerable}{infinito enumerável}{infinitos enumeráveis}

% Traduções globais de tokens lógicos para Português (PT-BR)
\settexttoken{language}{linguagem}{linguagens}
