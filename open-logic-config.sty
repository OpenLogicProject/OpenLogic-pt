\settexttoken{constant}{símbolo de constante}{símbolos de constante}
\settexttoken{predicate}{símbolo de predicado}{símbolos de predicado}
\settexttoken{function}{símbolo de função}{símbolos de função}
\settexttoken{operator}{operador lógico}{operadores lógicos}
\settexttoken{main operator}{operador principal}{operadores principais}
\settexttoken{free for}{livre para}{livres para}
\settexttoken{identity}*{predicado de identidade}{predicados de identidade}
\settexttoken{conditional}{condicional}{condicionais}
\settexttoken{biconditional}{bicondicional}{bicondicionais}
\settexttoken{falsity}{falsidade}{falsidades}
\settexttoken{truth}{verdade}{verdades}
\settexttoken{structure}{estrutura}{estruturas}
\settexttoken{valuation}{valoração}{valorações}
\settexttoken{domain}{domínio}{domínios}
\settexttoken{value}{valor}{valores}
\settexttoken{relational model}{modelo relacional}{modelos relacionais}
\settexttoken{derivation}{derivação}{derivações}
\settexttoken{derive}{deriva}{deriva}
\settexttoken{derivable}{derivável}{deriváveis}
\settexttoken{derivability}{derivabilidade}{derivabilidades}
\settexttoken{nonderivability}{não derivabilidade}{não derivabilidades}
\settexttoken{proof}{derivação}{derivações}
\settexttoken{prove}{deriva}{deriva}
\settexttoken{proving}{derivando}{derivando}
\settexttoken{provable}{derivável}{deriváveis}
\settexttoken{provability}{derivabilidade}{derivabilidades}
\settexttoken{nonprovability}{não derivabilidade}{não derivabilidades}
\settexttoken{tableau}{tableau}{tableaux}
\settexttoken{signed formula}{fórmula assinada}{fórmulas assinadas}
\settexttoken{complete}{completo}{completos}
\settexttoken{axiomatizable}*{axiomatizável}{axiomatizáveis}
\settexttoken{axiomatized}*{axiomatizado}{axiomatizados}
