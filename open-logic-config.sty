\settexttoken{representable}{representável}{representáveis}
\settexttoken{discharge}{descarrega}{descarregam}
\settexttoken{discharged}{descarregada}{descarregadas}
\settexttoken{undischarged}{não descarregada}{não descarregadas}
\settexttoken{decidable}{decidível}{decidíveis}
\settexttoken{computably enumerable}{computavelmente enumerável}{computavelmente enumeráveis}
\settexttoken{c.e.}{c.e.}{c.e.}
\settexttoken{argument}{argumento}{argumentos}
\settexttoken{parameter}{parâmetro}{parâmetros}
\settexttoken{lambda define}{\ensuremath{\lambda}-define}{\ensuremath{\lambda}-definem}
\settexttoken{lambda defined}{\ensuremath{\lambda}-definido}{\ensuremath{\lambda}-definidos}
