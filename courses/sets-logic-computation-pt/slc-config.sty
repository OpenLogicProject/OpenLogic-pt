% Configuration file for Sets, Logic, Computation textbook

% Let's be unpretentious and use A, B, C, etc. for formulas ...

\ollatinformulas

% ... and use bold italic instead of Fraktur for structures

\DeclareMathAlphabet{\mathbi}{OT1}{pplx}{b}{it}

\DeclareDocumentCommand \Struct { m }{\applytofirst{\mathbi}{#1}}

% - `\TMblank` - symbol for a blank
\DeclareDocumentMacro \TMblank {\sqcup}

% - `\TMstroke` - single stroke symbol on tape
\DeclareDocumentMacro \TMstroke {I}

% - `\TAss`: rótulo de justificação de hipótese em tableaux (localização PT;
%   o default em open-logic-config.sty é "Assumption")
\DeclareDocumentMacro \TAss {Hipótese}

% - `\Cut`: rótulo da regra de corte do cálculo de sequentes (o default em
%   open-logic-config.sty:218 é "Cut"). open-logic.sty carrega antes deste
%   ficheiro, por isso a redefinição prevalece.
\DeclareDocumentMacro \Cut {\ensuremath{\mathrm{Corte}}}

% - Diagramas de autómatos / máquinas de Turing: os nós "initial" mostram
%   "start" por defeito da biblioteca TikZ automata (carregada por
%   open-logic.sty). Localizar para "início".
\tikzset{initial text={início}}

% - Cabeçalho corrente (OLPpage): títulos PT longos (ex.: cap. 13 "Além da
%   lógica de primeira ordem", cap. 14 "Computações de Máquinas de Turing")
%   alcançavam/ultrapassavam o número de página em \small. Reduzir a fonte do
%   cabeçalho para \footnotesize dá folga. Vai em \AtBeginDocument porque a
%   classe só define o pagestyle OLPpage no início do documento (e o hook da
%   classe, registado antes deste, corre primeiro).
\AtBeginDocument{%
  \makeoddhead{OLPpage}{\footnotesize\sffamily\color{OLPcolor}\leftmark}{}%
    {\color{OLPcolor}\sffamily\bfseries\thepage}%
  \makeevenhead{OLPpage}{\footnotesize\sffamily\color{OLPcolor}\leftmark}{}%
    {\color{OLPcolor}\sffamily\bfseries\thepage}%
}

% Tokens EN do curso (sobrescritos pelos PT abaixo)
\settexttoken{enumerable}{countable}{countable}
\settexttoken{nonenumerable}*{uncountable}{uncountable}
\settexttoken{denumerable}{countably infinite}{countably infinite}

% Biconditional, verum are defined symbols

\tagtrue{defIff,defTrue}
\tagfalse{prvIff,prvTrue}

% I'll leave cases for conditional, universal quantifier as exercises

\tagtrue{probAnd,probIf,probAll}

\tagtrue{prfND,prfSC}
\tagfalse{prfAX,prfTab}

