% --- Localização PT da macro \indcase (caso atômico / exercício) ---
\RenewDocumentCommand \indcase { s t{!} m m +m }{%
  \DeclareDocumentMacro \indfrm {#3}%
  \DeclareDocumentMacro \indfrmp {#3}%
  \DeclareDocumentMacro \indcomplex {#4}%
  \IfBooleanTF{#1}
     {$#3$ é atômica: }{$#3 \ident #4$: }
  \IfBooleanTF{#2}
     {Exercício.}
     {#5}}

% --- Referências cruzadas em português (cleveref) ---
\AtBeginDocument{%
  \crefname{section}{seção}{seções}%
  \Crefname{section}{Seção}{Seções}%
  \crefname{chapter}{capítulo}{capítulos}%
  \Crefname{chapter}{Capítulo}{Capítulos}%
  \crefname{part}{parte}{partes}%
  \Crefname{part}{Parte}{Partes}%
  \crefname{appendix}{apêndice}{apêndices}%
  \Crefname{appendix}{Apêndice}{Apêndices}%
  % problem: faltava a forma minúscula (\cref) — o EN usa "problem N" em
  % minúsculas nas referências a meio de frase
  \crefname{prob}{problema}{problemas}%
  \Crefname{prob}{Problema}{Problemas}%
}
